generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Project {
  id             String   @unique  @default(uuid())
    program Program
    lastPiReportDate String?
    lastPiReportBalance Float?
    title String
    budget Float?
    startDate String
    endDate String
    funder String
    pi String
    fundingMechanism String // do we want to make this an enum?
    status String // do we want to make this an enum?
    projectAccount String
    taskNumber String
    indirectRate Float?    
    effortEntries EffortEntry[]
    softEndDate Boolean @default(false) // indicates if the end date is flexible and can be extended
}

model Person {
  id        String @unique  @default(uuid())
  firstName String
  lastName  String
  salary    Int
  salaryEnteredDate String
  program   Program
  effortEntries EffortEntry[]
}

model EffortEntry {
    id             String   @unique  @default(uuid())
  employee Person @relation(fields: [employeeId], references: [id])
  employeeId String
  project Project @relation(fields: [projectId], references: [id])
  projectId  String
  effortStartDate String
  effortEndDate String
  percentEffort Int?
}

enum Program {
  DIGDEV
  DIGGIS
  EACPOLICY
  EACPLANNING
  CCRC
  PUBLICHEALTH
}