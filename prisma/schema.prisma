generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Project {
  id                  String  @id @unique @default(uuid())
  lastPiReportDate    String?
  lastPiReportBalance Float?
  title               String
  budget              Float?
  startDate           String
  endDate             String
  funder              String
  pi                  String
  fundingMechanism    String // do we want to make this an enum?
  status              String // do we want to make this an enum?
  projectAccount      String
  taskNumber          String
  indirectRate        Float?
  softEndDate         Boolean @default(false) // indicates if the end date is flexible and can be extended
  program             Program

  // Relationships
  efforts Effort[]
  persons Person[]
}

model Person {
  id                String  @id @unique @default(uuid())
  firstName         String
  lastName          String
  salary            Int
  salaryEnteredDate String
  program           Program

  // Relationships
  efforts  Effort[]
  projects Project[]
}

model Effort {
  id              String @id @unique @default(uuid())
  payrollDate   String
  percentEffort   Int?

  // Relationships
  employee   Person  @relation(fields: [employeeId], references: [id])
  employeeId String
  project    Project @relation(fields: [projectId], references: [id])
  projectId  String
}

enum Program {
  DIGDEV
  DIGGIS
  EACPOLICY
  EACPLANNING
  CCRC
  PUBLICHEALTH
}
